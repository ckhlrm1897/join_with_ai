    {
      "parameters": {
        "jsCode": "let now = new Date();\nconst firebaseData = $json;\n\nif (!firebaseData || typeof firebaseData !== 'object') {\n  return [];\n}\n\nlet startOfToday = new Date(now);\nstartOfToday.setHours(0, 0, 0, 0);\nlet endOfToday = new Date(now);\nendOfToday.setHours(23, 59, 59, 999)\nconst keys = Object.keys(firebaseData);\nif (keys.length > 0) {\n    let todaysAiRequestedTasks = keys.filter(key => {\n      let createdAt = firebaseData[key].createdAt;\n      let aigenerated = firebaseData[key].aigenerated;\n      if (!createdAt) return false;\n      if (!aigenerated) return false;\n      let date = new Date(createdAt);\n      return date >= startOfToday && date <= endOfToday;\n    })\n    return [{ json: { aiGeneratedKeys: todaysAiRequestedTasks } }];\n  }\n\nreturn [];"
      },
